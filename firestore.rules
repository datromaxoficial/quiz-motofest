rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // E-mails que entram no painel (usuários criados em Authentication > Usuários). Para adicionar outro: ["a@x.com", "b@y.com"].
    function admin() {
      return request.auth != null && request.auth.token.email in ['quiz.exclusivegold@gmail.com'];
    }

    // O totem só cria participações; ler e editar é só no painel.
    match /leads/{id} {
      allow create: if request.resource.data.id == id
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 15
        && request.resource.data.placa is string && request.resource.data.placa.size() <= 8;
      allow update: if admin() || (resource.data.id == id && request.resource.data.id == id
        && request.resource.data.whatsapp == resource.data.whatsapp);
      allow read, delete: if admin();
    }

    // Contador de uso por placa (para avisar "essa placa já foi registrada"). Só número, sem dado pessoal.
    match /placas/{placa} {
      allow get: if true;
      allow list: if admin();
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if admin();
    }

    // Perguntas, limite de chopps e pausa: todos leem, só o painel altera.
    match /config/{doc} {
      allow read: if true;
      allow write: if admin();
    }

    // Contador de chopps: o totem só pode somar 1.
    match /stats/{doc} {
      allow read: if true;
      allow create: if admin() || request.resource.data.chopsGiven == 1;
      allow update: if admin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chopsGiven'])
        && request.resource.data.chopsGiven == resource.data.chopsGiven + 1);
    }
  }
}
